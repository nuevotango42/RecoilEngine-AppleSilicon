+void CInitScript::GenericLog(asIScriptGeneric* generic)
+{
+	CInitScript* self = static_cast<CInitScript*>(generic->GetAuxiliary());
+	const std::string* msg = static_cast<const std::string*>(generic->GetArgObject(0));
+	self->Log(*msg);
+}
+
+void CInitScript::GenericDice(asIScriptGeneric* generic)
+{
+	CInitScript* self = static_cast<CInitScript*>(generic->GetAuxiliary());
+	const CScriptArray* array = static_cast<const CScriptArray*>(generic->GetArgObject(0));
+	generic->SetReturnDWord(static_cast<asDWORD>(self->Dice(array)));
+}
+
+void CInitScript::GenericMaxInt(asIScriptGeneric* generic)
+{
+	CInitScript* self = static_cast<CInitScript*>(generic->GetAuxiliary());
+	const int left = static_cast<int>(generic->GetArgDWord(0));
+	const int right = static_cast<int>(generic->GetArgDWord(1));
+	generic->SetReturnDWord(static_cast<asDWORD>(self->Max<int>(left, right)));
+}
+
+void CInitScript::GenericMaxFloat(asIScriptGeneric* generic)
+{
+	CInitScript* self = static_cast<CInitScript*>(generic->GetAuxiliary());
+	const float left = generic->GetArgFloat(0);
+	const float right = generic->GetArgFloat(1);
+	generic->SetReturnFloat(self->Max<float>(left, right));
+}
+
+void CInitScript::GenericAddRole(asIScriptGeneric* generic)
+{
+	CInitScript* self = static_cast<CInitScript*>(generic->GetAuxiliary());
+	const std::string* name = static_cast<const std::string*>(generic->GetArgObject(0));
+	const int actAsRole = static_cast<int>(generic->GetArgDWord(1));
+	CMaskHandler::TypeMask result = self->AddRole(*name, actAsRole);
+	generic->SetReturnObject(&result);
+}
